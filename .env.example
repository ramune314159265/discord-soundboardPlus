# --- Discord Developer Portal で取得 ---
# Application ID (= OAuth2 Client ID)
DISCORD_CLIENT_ID=
# OAuth2 > Client Secret
DISCORD_CLIENT_SECRET=
# Bot > Token
DISCORD_BOT_TOKEN=

# クライアント(Vite)にも同じ Client ID を渡す。上と同じ値にしてください
VITE_DISCORD_CLIENT_ID=

# --- サーバー設定 (任意) ---
PORT=3000
# サウンドJSON/音声ファイルの保存先 (相対パスはプロジェクトルート基準)
DATA_DIR=./data
# アップロード上限(バイト)。既定 8MB
MAX_UPLOAD_BYTES=8388608
# 通話にボット以外が誰もいなくなってから、ボットが自動で退出するまでの猶予(ミリ秒)。0 で即時。既定 5000
AUTO_LEAVE_DELAY_MS=5000

# --- ブラウザ(アクティビティの外)から鳴らす機能 (任意) ---
# このサーバーの公開URL (末尾の / なし)。設定すると /auth/login からDiscordログインできます。
# Developer Portal > OAuth2 > Redirects に「<PUBLIC_URL>/auth/callback」を登録してください
PUBLIC_URL=
