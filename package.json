{
  "name": "discord-soundboard-activity",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev:server": "npm run dev -w server",
    "dev:client": "npm run dev -w client",
    "build": "npm run build -w client",
    "start": "npm run start -w server",
    "register-commands": "npm run register-commands -w server",
    "test": "npm test -w server && npm test -w client"
  },
  "engines": {
    "node": ">=22.12"
  }
}
